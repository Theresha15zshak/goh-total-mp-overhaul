{
  "name": "goh-online",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": { "crons": ["0 */2 * * *"] },
  "vars": { "MODERATORS": "76561198957790948" },
  // requests per IP address and minute (src/index.js): everything, and what writes
  "ratelimits": [
    { "name": "LIMIT_ALL", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "LIMIT_WRITE", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goh-online",
      "database_id": "38558763-7013-410b-8fb1-60901328826f"
    }
  ]
}
